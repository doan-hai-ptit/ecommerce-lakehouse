# Linux: chạy `id -u` để lấy AIRFLOW_UID. Windows/macOS có thể giữ 50000.
AIRFLOW_UID=50000

# Đường dẫn tuyệt đối tới repository trên máy host.
# Linux/macOS example: /home/user/ecommerce-lakehouse
# Windows Docker Desktop example: D:/Code/Python/ecommerce-lakehouse
HOST_WORKSPACE_PATH=/absolute/path/to/ecommerce-lakehouse

# Linux: group id có quyền truy cập Docker socket (`getent group docker`).
DOCKER_GID=0

# Tùy chọn của Docker Compose Airflow
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me
_PIP_ADDITIONAL_REQUIREMENTS=
