# Các hostname bên dưới dùng trong Docker Compose network.
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=bronze-lakehouse

# Lakehouse paths
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_BRONZE_PATH=s3a://bronze-lakehouse/kafka_cdc
SILVER_BASE_PATH=s3a://silver-lakehouse
REAL_SILVER_BASE_PATH=s3a://silver-lakehouse/real_data
GOLD_BASE_PATH=s3a://gold-lakehouse
SPARK_WAREHOUSE_DIR=s3a://silver-lakehouse/warehouse/

# Hive Metastore
HIVE_SITE_PATH=/opt/spark/conf/hive-site.xml
HIVE_METASTORE_JDBC_URL=jdbc:postgresql://postgres:5432/postgres_metastore
HIVE_METASTORE_JDBC_USER=postgres
HIVE_METASTORE_JDBC_PASSWORD=postgres
SILVER_HIVE_DATABASE=silver
GOLD_HIVE_DATABASE=gold

# Processing
SPARK_LOG_LEVEL=WARN
SPARK_SQL_SHUFFLE_PARTITIONS=16
BRONZE_TO_SILVER_PROCESSING_TIME=30 seconds
SILVER_TO_GOLD_PROCESSING_TIME=10 seconds

# ClickHouse serving
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=password123
CLICKHOUSE_GOLD_DATABASE=gold_serving
CLICKHOUSE_SILVER_REAL_DATABASE=silver_real_serving

# Remote export targets (tùy chọn)
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_DATABASE=
