# Kết nối từ ứng dụng chạy trên máy host
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_NAME=bronze-lakehouse
BROWSERLESS_URL=http://localhost:3000/webdriver

# Shopee (tùy chọn). Không commit cookie thật.
SHOPEE_COOKIE=
SHOPEE_FETCH_MODE=api
SHOPEE_MIN_DELAY_SECONDS=3
SHOPEE_MAX_DELAY_SECONDS=8
SHOPEE_MAX_RETRIES=3

# Metabase local (tùy chọn, dùng cho analytics/metabase scripts)
METABASE_URL=http://localhost:3001
METABASE_USER=admin@example.com
METABASE_PASSWORD=change_me

# Database đích ở xa (tùy chọn)
REMOTE_DB_HOST=
REMOTE_DB_PORT=5432
REMOTE_DB_USER=
REMOTE_DB_PASSWORD=
REMOTE_DB_DATABASE=

# MinIO ở xa (tùy chọn)
REMOTE_MINIO_ENDPOINT=
REMOTE_MINIO_ACCESS_KEY=
REMOTE_MINIO_SECRET_KEY=

# ClickHouse ở xa (tùy chọn)
REMOTE_CLICKHOUSE_HOST=
REMOTE_CLICKHOUSE_PORT=8123
REMOTE_CLICKHOUSE_USER=admin
REMOTE_CLICKHOUSE_PASSWORD=
REMOTE_CLICKHOUSE_SECURE=false
